{
  "expo": {
    "name": "SmartBin",
    "slug": "smart-waste",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#17201b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pfe.smartwaste",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "L'application a besoin de votre position pour calculer la distance aux conteneurs."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#17201b"
      },
      "package": "com.pfe.smartwaste",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "L'application a besoin de votre position pour calculer la distance aux conteneurs."
        }
      ],
      "expo-asset",
      "expo-font"
    ]
  }
}
